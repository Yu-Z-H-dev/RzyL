BASE_URL=https://api.longcat.chat/openai/v1 #使用openai格式的API
API_KEY=""
MODEL_CHAT=""
MODEL_THINK=""
MODEL_LITE=""
# —— 彩蛋插件独立 AI 配置（可选，仅 easter_egg 生效，覆盖上面的共用值）——
# 留空则回退到上面的 BASE_URL / API_KEY / MODEL_THINK / MODEL_CHAT
# 例：让彩蛋单独走学校网关的 deepseek-flash
EASTER_EGG_BASE_URL=
EASTER_EGG_API_KEY=
EASTER_EGG_MODEL_THINK=
EASTER_EGG_MODEL_CHAT=
AI_TIMEOUT=180 # AI 请求总超时秒数（推理模型建议 ≥180），留空默认 180，三个 AI 插件共用
AI_CONCURRENCY=5 # AI 请求并发上限（默认 5），过高冲击API链路、过低排队拖慢
DAWU_ALLOWED_GROUPS= # 允许使用dawu插件的群聊，多个群号用逗号分隔，留空表示所有群聊都可以使用
JIESHI_ALLOWED_GROUPS= # 「解释」命令的群白名单：仅这些群可用，多个群号用逗号分隔；留空=所有群可用（私聊永不受限）
# 彩蛋对话回退提示词已迁移至独立文件 src/asserts/easter_egg/prompt_chat.md（支持自由换行），不再从 env 读取

# —— 入群申请自动验证（group_verify，qq.ustc.life 证明码）——
# 开启前建议先 GROUP_VERIFY_ENABLED=true + GROUP_VERIFY_DRY_RUN=true 观察日志
GROUP_VERIFY_ENABLED=false # 总开关（默认 false）
GROUP_VERIFY_GROUP_WHITELIST= # 群号白名单，逗号分隔；留空 = 哪个群都不处理
GROUP_VERIFY_DRY_RUN=true # true=只记录将执行的审批，不真调用 set_group_add_request
GROUP_VERIFY_MIN_REQUEST_INTERVAL_SECONDS=1 # 对 qq.ustc.life 的全局最小请求间隔（站点 FAQ 要求 ≥1s）
GROUP_VERIFY_QUEUE_MAX_SIZE=10 # 同时在排队的申请上限，超出转人工
GROUP_VERIFY_QUEUE_WAIT_SECONDS=30 # 单个申请最长排队时间，超时转人工
GROUP_VERIFY_STUDENT_ID_PATTERN=^PB\d{8}$ # 学号正则（更严的本科生学号；放宽可改 ^[A-Z]{2}\d{8}$）
GROUP_VERIFY_REQUEST_TIMEOUT_SECONDS=10 # 抓取证明页超时
GROUP_VERIFY_PROOF_URL_TEMPLATE=https://qq.ustc.life/p/{code}/ # 证明页地址模板
GROUP_VERIFY_FLAG_TTL_SECONDS=600 # flag 幂等窗口，防事件重放重复审批
GROUP_VERIFY_REQUIRE_FULL_STUDENT_ID=true # 要求申请人展示完整学号；掩码学号一律拒（理由会告知重新生成）
GROUP_VERIFY_REQUIRE_NAMELIST=true # 全码学号必须能在 GetNameList 名单里精确查到；名单不可用则转人工
GROUP_VERIFY_NAMELIST_PATH=/home/ubuntu/ustc_bot/GetNameList/data/final/identity.json # 只读，勿改
GROUP_VERIFY_NAMELIST_COHORTS=2024,2025,2026 # 允许的届别（学号 PB+届+6位）
