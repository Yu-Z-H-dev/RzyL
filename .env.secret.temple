BASE_URL=https://api.longcat.chat/openai/v1 #使用openai格式的API
API_KEY=""
MODEL_CHAT=""
MODEL_THINK=""
MODEL_LITE=""
# —— 彩蛋插件独立 AI 配置（可选，仅 easter_egg 生效，覆盖上面的共用值）——
# 留空则回退到上面的 BASE_URL / API_KEY / MODEL_THINK / MODEL_CHAT
# 例：让彩蛋单独走学校网关的 deepseek-flash
EASTER_EGG_BASE_URL=
EASTER_EGG_API_KEY=
EASTER_EGG_MODEL_THINK=
EASTER_EGG_MODEL_CHAT=
AI_TIMEOUT=180 # AI 请求总超时秒数（推理模型建议 ≥180），留空默认 180，三个 AI 插件共用
AI_CONCURRENCY=5 # AI 请求并发上限（默认 5），过高冲击API链路、过低排队拖慢
DAWU_ALLOWED_GROUPS= # 允许使用dawu插件的群聊，多个群号用逗号分隔，留空表示所有群聊都可以使用
# 彩蛋对话回退提示词已迁移至独立文件 src/asserts/easter_egg/prompt_chat.md（支持自由换行），不再从 env 读取
